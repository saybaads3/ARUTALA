# Salin menjadi .env.local untuk pengembangan lokal.
# Tanpa kredensial, situs publik tetap jalan memakai data proposal,
# tetapi panel admin dan pesanan merch nonaktif.
#
# Untuk Vercel: isi variabel yang sama di
# Project > Settings > Environment Variables (Production, Preview, Development).
# Jangan pernah commit file .env.local.

# Domain produksi. Dipakai metadata, sitemap, robots, dan canonical URL.
NEXT_PUBLIC_SITE_URL=https://arutala.web.id

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pisahkan dengan koma bila lebih dari satu email admin.
ADMIN_EMAILS=
